{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.7-plus",
  "formatter": {
    "prettier": {
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".css", ".json"]
    }
  },
  "permission": {
    "edit": {
      "*.test.ts": "deny",
      "*.test.tsx": "deny",
      "*AGENTS.md": "deny",
      "*SPEC.md": "deny",
      "*opencode.json": "deny",
      "*.opencode/*": "deny",
      "*tsconfig.json": "deny",
      "*node_modules/*": "deny",
      "*.next/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*eslint.config.*": "deny",
      "*.prettierrc*": "deny",
      "*.prettierignore": "deny",
      "*next.config.*": "ask",
      "*package.json": "ask",
      "*package-lock.json": "ask",
      "*vitest.config.ts": "deny",
      "*vitest.setup.ts": "deny",
      "*agent-logs/verification-logs/*-logs/*": "deny",
      "*agent-logs/performance-logs/*": "deny",
      "*agent-logs/client-requests/*": "ask"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "date": "allow",
      "date *": "allow",
      "mkdir *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm run verify*": "allow",
      "npm run perf*": "allow",
      "npx tsc*": "deny",
      "npx eslint*": "deny",
      "npx prettier*": "deny",
      "npm run lint*": "deny",
      "npm run format*": "deny",
      "npm run build*": "deny",
      "npm test*": "deny",
      "npx vitest*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "rm -rf*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "*.env*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny"
  },
  "tools": {
    "accessibility_audit": true,
    "seo_audit": true
  },
  "agent": {
    "build": {
      "steps": 120
    }
  }
}