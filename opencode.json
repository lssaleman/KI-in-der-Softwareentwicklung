{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.8-flash",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*AGENTS.md": "deny",
      "*SPEC.md": "deny",
      "*opencode.json": "deny",
      "*.opencode/*": "deny",
      "*tsconfig.json": "deny",
      "*node_modules/*": "deny",
      "*.next/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*package.json": "ask",
      "*package-lock.json": "ask",
      "*vitest.config.ts": "deny"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "npx tsc --noEmit*": "allow",
      "npm run build*": "allow",
      "npm run dev*": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm uninstall*": "ask",
      "npm test*": "allow",
      "npx vitest*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "rm -rf*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "*.env*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "ask"
  },
  "tools": {
    "accessibility_audit": true
  }
}