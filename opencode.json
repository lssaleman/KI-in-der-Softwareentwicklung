{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.7-plus",
  "permission": {
    "edit": {
      "*.test.ts": "deny",
      "*.test.tsx": "deny",
      "*AGENTS.md": "deny",
      "*SPEC.md": "deny",
      "*opencode.json": "deny",
      "*.opencode/*": "deny",
      "*tsconfig.json": "deny",
      "*node_modules/*": "deny",
      "*.next/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*package.json": "ask",
      "*package-lock.json": "ask",
      "*vitest.config.ts": "deny"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "npx tsc --noEmit*": "allow",
      "npm run build*": "allow",
      "npm test*": "allow",
      "npx vitest*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "rm -rf*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "*.env*": "deny",
      "echo *": "allow",
      "date": "allow",
      "tee *": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny"
  },
  "tools": {
    "accessibility_audit": true,
    "seo_audit": true
  }
}