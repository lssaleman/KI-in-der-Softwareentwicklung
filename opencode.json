{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.7-plus",
  "permission": {
    "edit": {
      "*.test.ts": "deny",
      "*.test.tsx": "deny",
      "*AGENTS.md": "deny",
      "*SPEC.md": "deny",
      "*opencode.json": "deny",
      "*.opencode/*": "deny",
      "*tsconfig.json": "deny",
      "*node_modules/*": "deny",
      "*.next/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*package.json": "ask",
      "*package-lock.json": "ask",
      "*vitest.config.ts": "deny"
    },
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "mkdir *": "allow", 
      "head *": "allow",
      "tail *": "allow",
      "npx vitest*": "deny",
      "npx tsc*": "deny",
      "npm run verify*": "allow",
      "npm run format*": "allow", 
      "npm run test*": "allow", 
      "npm run build*": "deny",
      "npm test*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "rm -rf*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "*.env*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny"
  },
  "mcp": {
    "servers": {
      "supabase": {
        "enabled": false,
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=oxjmnufisirduhymikqb&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cfeedback%2Cnotebooks"
      }
    }
  },
  "tools": {
    "accessibility_audit": true,
    "seo_audit": true
  },
  "agent": {
    "build": {
      "steps": 120
    }
  }
}